# --- Supabase (wajib untuk login, premium, admin, favorites, history) ---
# Tanpa dua variabel ini website tetap jalan dalam mode tamu (semua tool dasar tetap bisa dipakai).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Situs ---
NEXT_PUBLIC_SITE_URL=https://toolsphone.auctionnuvexastore.biz.id

# --- Android APK (opsional, bisa juga diatur dari /admin -> Aplikasi) ---
# Kosong = tombol tampil "Coming Soon".
NEXT_PUBLIC_APK_URL=
NEXT_PUBLIC_APK_VERSION=v1.0.0

# --- Kontak (opsional, bisa juga diatur dari /admin -> Aplikasi) ---
# Hanya kontak yang diisi yang akan ditampilkan.
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_TIKTOK_URL=

# CATATAN: JANGAN pernah menaruh Supabase Service Role Key di sini / di frontend.
# Project ini tidak membutuhkannya: semua aksi admin berjalan lewat RPC + RLS.
